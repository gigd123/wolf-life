{
  "_comment": "轉變與回饋提示（SPEC 1.6「轉變與回饋提示」）。文字都是翻譯鍵，撰寫依 docs/writing-guide.md。",
  "_season_cards_comment": "季節卡片：full／short 是第一次與之後的描述；if 的條件：identified:<動物> 已辨識、sensed:<動物> 還沒辨識但察覺過危險（{region} 換成察覺最多次的區域）。",
  "_season_cards_by_map_comment": "苔原的季節卡片（使用者決定要補）：換季時人在苔原，或第一次在某個季節來到苔原時顯示；格式同 season_cards，另外有 seen:<life_log 的鍵>（那件事發生過）的條件。第一次與之後的精簡版分開記（life_log.seasons_seen 的 tundra:<季節>）。",
  "season_cards_by_map": {
    "tundra": {
      "spring": [
        { "full": "season_card.tundra.spring.full", "short": "season_card.tundra.spring.short" },
        { "if": "identified:tundra_wolf", "text": "season_card.tundra.spring.tundra_wolf" }
      ],
      "summer": [
        { "full": "season_card.tundra.summer.full", "short": "season_card.tundra.summer.short" },
        { "if": "identified:grizzly_bear", "text": "season_card.tundra.summer.bear_known" }
      ],
      "autumn": [
        { "full": "season_card.tundra.autumn.full", "short": "season_card.tundra.autumn.short" },
        { "if": "identified:tundra_wolf", "text": "season_card.tundra.autumn.tundra_wolf" }
      ],
      "winter": [
        { "full": "season_card.tundra.winter.full", "short": "season_card.tundra.winter.short" },
        { "if": "seen:blizzards", "text": "season_card.tundra.winter.blizzard" },
        { "if": "identified:wolverine", "text": "season_card.tundra.winter.wolverine" }
      ]
    }
  },
  "season_cards": {
    "spring": [
      { "full": "season_card.spring.full", "short": "season_card.spring.short" },
      { "if": "identified:grizzly_bear", "text": "season_card.spring.bear_known" },
      { "if": "sensed:grizzly_bear", "animal": "grizzly_bear", "text": "season_card.spring.bear_sensed" }
    ],
    "summer": [
      { "full": "season_card.summer.full", "short": "season_card.summer.short" }
    ],
    "autumn": [
      { "full": "season_card.autumn.full", "short": "season_card.autumn.short" }
    ],
    "winter": [
      { "full": "season_card.winter.full", "short": "season_card.winter.short" },
      { "if": "identified:grizzly_bear", "text": "season_card.winter.bear_known" },
      { "if": "sensed:grizzly_bear", "animal": "grizzly_bear", "text": "season_card.winter.bear_sensed" }
    ]
  },
  "_day_summary_comment": "換日摘要：hunger_tier_N 是飢餓懲罰段數變成 N（0 = 解除）；heavy_healed_<能力> 依重傷影響的能力。",
  "day_summary": {
    "hunger_tier_0": "day_summary.hunger_recovered",
    "hunger_tier_1": "day_summary.hunger_low",
    "hunger_tier_2": "day_summary.hunger_severe",
    "light_healed": "day_summary.light_healed",
    "heavy_healed": "day_summary.heavy_healed",
    "heavy_healed_speed": "day_summary.heavy_healed_speed",
    "heavy_healed_strength": "day_summary.heavy_healed_strength",
    "heavy_healed_perception": "day_summary.heavy_healed_perception",
    "poison_healed": "day_summary.poison_healed"
  },
  "_sleep_summary_comment": "睡覺結算的原因句：速度或力量提升時顯示，鍵為「飽食.活動」。飽食：full（飽食度 ≥ full_hunger）、ok、hungry（飢餓懲罰中）；活動：chase（追擊較多）、fight（搏鬥較多）。",
  "sleep_summary": {
    "full_hunger": 70,
    "min_gain": 0.05,
    "starved_points": 15,
    "starved_mult": 0.3,
    "reasons": {
      "starved": "sleep_reason.starved",
      "full.chase": "sleep_reason.full_chase",
      "full.fight": "sleep_reason.full_fight",
      "ok.chase": "sleep_reason.ok_chase",
      "ok.fight": "sleep_reason.ok_fight",
      "hungry.chase": "sleep_reason.hungry_chase",
      "hungry.fight": "sleep_reason.hungry_fight"
    }
  },
  "_adult_transition_comment": "成年卡片的身體描述：依次成年期成長最多的能力（stat）與主要狩獵傾向（tendency），取第一條符合的規則；沒寫的條件不限制。",
  "adult_transition": {
    "intro": "adult_body.intro",
    "rules": [
      { "stat": "speed", "tendency": "pursuit", "key": "adult_body.speed_pursuit" },
      { "stat": "strength", "tendency": "assault", "key": "adult_body.strength_assault" },
      { "stat": "perception", "tendency": "cautious", "key": "adult_body.perception_cautious" },
      { "stat": "skill", "tendency": "stealth", "key": "adult_body.skill_stealth" },
      { "stat": "speed", "key": "adult_body.speed" },
      { "stat": "strength", "key": "adult_body.strength" },
      { "stat": "skill", "key": "adult_body.skill" },
      { "stat": "perception", "key": "adult_body.perception" },
      { "stat": "health_max", "key": "adult_body.health_max" },
      { "key": "adult_body.default" }
    ]
  },
  "elder_transition": {
    "body": "elder_body.text",
    "growing": ["skill"]
  }
}
